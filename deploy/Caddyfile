# Automatic HTTPS for the real domain. Set DOMAIN in deploy/.env and enable the `caddy` profile.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# www.<domain> -> <domain> (needs its own DNS record; until it exists Caddy just keeps retrying that one certificate).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
