# Copy to .env and fill in. Never commit real values. Server-side only: none of these ever reach the browser.
# Production: use deploy/.env.example (it lists what the server needs and generates the secrets for you).

NODE_ENV=development

# --- Data stores (docker-compose.dev.yml starts both) ---
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379

# --- MoySklad: ONE of the three things you must provide ---------------------------------------------
# Token of a dedicated MoySklad employee (read products/stock, write orders/counterparties; admin rights only to register webhooks).
# Leave empty to run WITHOUT MoySklad: the owner adds categories, products, prices, stock and photos in /admin, and orders are
# handled in /admin (statuses are shown to the customer). Connecting MoySklad later keeps those manual products untouched.
MOYSKLAD_TOKEN=
MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2
# 4 = user token (strictest limit from 2026-12-01: 11 requests / 3 s). 1 only for an approved solution token.
MOYSKLAD_REQUEST_WEIGHT=4
# Random string in the webhook URL path (>= 24 chars). Without it webhooks are skipped and polling does all the work.
MOYSKLAD_WEBHOOK_SECRET=
# Where MoySklad should call back, if different from PUBLIC_URL (demo: internal address).
MOYSKLAD_WEBHOOK_BASE_URL=

# --- Telegram: the SECOND thing you must provide -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back in a header so only Telegram can call the bot webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Domain: the THIRD thing you must provide ----------------------------------------------------------
# https address of the site (Telegram Mini Apps and MoySklad webhooks require https).
PUBLIC_URL=http://localhost:3000
API_PORT=4000
# Address of the API as seen by the web app's server (a compose service name in production).
API_INTERNAL_URL=http://localhost:4000

# --- Secrets (generate: openssl rand -hex 32) ---
SESSION_SECRET=
# ONE absolute folder shared by api and worker (our resized copies of MoySklad photos).
MEDIA_DIR=/absolute/path/to/data/media
REVALIDATE_SECRET=
WEB_REVALIDATE_URL=http://localhost:3000/hooks/revalidate

# --- First admin (created on first boot when none exists; 12+ chars in production) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional abuse protection for guest checkout (Cloudflare Turnstile) ---
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- Development only ---
# Open /tma in a plain browser with a stand-in user. The server REFUSES this in production when a bot token is set.
TMA_DEV_MODE=false
SYNC_ON_BOOT=true
TRUST_PROXY=true
LOG_LEVEL=info
